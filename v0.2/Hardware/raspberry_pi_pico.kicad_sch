	)
	(text "If you are using a real\nPico, this jumper bridges\na Schottky diode\nfrom USB in to Vsys\n(4.7v with it open,\n5.0v from USB port\nwith it soldered)"
		(exclude_from_sim no)
		(at 150.622 45.212 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "770c5160-e22d-48d5-857e-b915a21a505a")
	)
	(text "These jumpers are\nfor changing GPIO\npins if necessary.\nThey also allow you\nto connect modules\nsimilar to a \nbreadboard."
